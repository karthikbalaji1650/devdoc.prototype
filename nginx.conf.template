map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name localhost;

    # Security headers (SRS #13). Scoped to what this app actually loads:
    # Google Identity Services (login) and Drive (export), Google Fonts,
    # the Gemini / OpenAI APIs when AI assist is configured with them, and
    # the backend API (server/) at BACKEND_ORIGIN - substituted from the
    # environment at container start (NGINX_ENVSUBST_FILTER below limits
    # substitution to just this one variable, so nginx's own $host,
    # $http_upgrade etc. below are left alone). Empty when unset: the app
    # still runs, just without that origin allow-listed.
    # frame-src includes 'self' for the Coder screen's embedded code-server
    # - reached via the same-origin /vscode/ proxy below, never a direct
    # cross-origin port, so no extra origin needs allow-listing here.
    # Known, remaining gap: a custom Ollama URL (not the localhost default
    # already listed) still isn't covered - it's configured per-browser in
    # Settings, with nowhere server-side to read it from at container start.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://generativelanguage.googleapis.com https://api.openai.com http://localhost:11434 ${BACKEND_ORIGIN}; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    # Reverse-proxy ALL /vscode/* traffic to code-server.
    # This must be declared before the catch-all location / so that
    # Nginx prefix-matching gives it priority.
    # The trailing-slash on proxy_pass strips the /vscode prefix
    # before forwarding to the upstream.
    location /vscode/ {
        proxy_pass http://vscode-cline:8080/;
        proxy_http_version 1.1;

        # Correct WebSocket upgrade pattern (map handles both WS and HTTP)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Forward real client info
        # $http_host keeps the port: code-server 403s the websocket unless
        # Host matches the browser's Origin exactly (blank workbench).
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep WebSocket connections alive (86400 s = 24 h)
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        # Remove headers that block iframe embedding
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header X-Frame-Options "ALLOWALL" always;
    }

    # React SPA catch-all — serve index.html for any unknown path
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }
}
