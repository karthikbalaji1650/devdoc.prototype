# Postgres connection string. docker-compose sets this automatically
# for the `api` service; only needed by hand when running the API
# outside Docker (npm run dev inside server/).
DATABASE_URL=postgres://platform_admin:platform_secure_password_2026@localhost:5432/platform_db

# Port the API listens on.
PORT=4000

# Marks the session cookie Secure (browsers then only send it back over
# HTTPS). Leave unset/false for plain-HTTP setups, including this
# repo's own docker-compose demo - setting it there breaks login, since
# the browser accepts the cookie on sign-in but drops it on the very
# next request over HTTP. Set to true only when this API is actually
# served over HTTPS.
# COOKIE_SECURE=true

# Comma-separated list of origins allowed to send cookies (the
# frontend's dev and deployed URLs). Leave empty to disable CORS
# entirely (fine when the frontend and API are served from the same
# origin behind a reverse proxy).
CORS_ORIGINS=http://localhost:5173

# Optional: set either of these to let the frontend's AI rephrase
# feature use this server as a proxy, so the key lives only here, never
# in the browser. Leave unset and the frontend falls back to its own
# per-browser key (Settings -> AI Assistant), unchanged.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
