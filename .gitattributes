# Check out every text file with LF line endings, on every OS.
# Without this, Git for Windows (core.autocrlf=true) writes CRLF, and the
# shell scripts that run inside the Linux containers fail to start:
#   web-app:      /docker-entrypoint.d/15-devdoc-tls.sh: not found  (exit 127)
#   vscode-cline: /home/coder/entrypoint.sh: No such file or directory
* text=auto eol=lf

# Binary files: never touch their bytes.
*.png     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.numbers binary
