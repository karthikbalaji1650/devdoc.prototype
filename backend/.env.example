# Postgres connection string. docker-compose sets this automatically
# for the `api` service; only needed by hand when running the API
# outside Docker (uv run uvicorn ... inside backend/).
DATABASE_URL=postgresql://platform_admin:platform_secure_password_2026@localhost:5432/platform_db

# Redis connection string: test management data (and other data the
# frontend used to keep in the browser) lives here. Required.
# docker-compose sets it for the `api` service; run one by hand with
# `docker compose up redis`.
REDIS_URL=redis://localhost:6379/0

# Port the API listens on in the Docker image (uvicorn's --port when run by hand).
PORT=8000

# Marks the session cookie Secure (browsers then only send it back over
# HTTPS). Only the exact value `true` turns it on. Leave unset for
# plain-HTTP setups, including this repo's own docker-compose demo -
# setting it there breaks login, since the browser accepts the cookie on
# sign-in but drops it on the very next request over HTTP.
# COOKIE_SECURE=true

# Comma-separated list of origins allowed to send cookies (the
# frontend's dev and deployed URLs). Leave empty to disable CORS
# entirely (fine when the frontend and API are served from the same
# origin behind a reverse proxy).
CORS_ORIGINS=http://localhost:5173

# Optional: set either of these to let the frontend's AI features use
# this server as a proxy, so the key lives only here, never in the
# browser. Leave unset and the frontend falls back to its own
# per-browser key (Settings -> AI Assistant), unchanged.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Encrypts the credentials of registered remote test servers at rest
# (AES-256-GCM). 32 random bytes, base64. Generate one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep it out of version control and back it up: if it is lost or changed,
# stored credentials cannot be decrypted and must be entered again. Unset,
# only test servers without credentials can be registered.
# SECRETS_KEY=

# The code editor's file bridge (sandbox/file_bridge.py), for connecting
# existing Git repositories to its workspace (DDS-SRS-030). docker-compose
# sets BRIDGE_URL. Set the same BRIDGE_TOKEN here and on the bridge:
# without it, the bridge's git endpoints are open to anyone who can reach it.
# BRIDGE_URL=http://localhost:8081
# BRIDGE_TOKEN=

# JWT access tokens (POST /api/auth/token; DDS-SRS-076). HS256 key, at least
# 32 characters. Leave unset to derive one from SECRETS_KEY.
# JWT_SECRET=

# Single sign-on with any OpenID Connect provider (Microsoft Entra ID, Okta,
# Google, Keycloak, ...). Register DevDoc Studio as a web app with the
# redirect URI below; set the first four to turn it on. People sign in only
# to existing accounts with the same email - nobody is created automatically.
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Microsoft
# OIDC_POST_LOGIN_URL=http://localhost:5173/
