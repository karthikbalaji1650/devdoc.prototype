# ==========================================
# Dev Dockerfile — Vite dev server with hot reload
# ==========================================
FROM node:22-alpine
WORKDIR /app

# Install once from lockfile; the actual source is bind-mounted at
# runtime (see docker-compose.yml), so it's not COPYed here.
COPY package*.json ./
RUN npm ci

EXPOSE 5173

# --host is required so Vite listens on all interfaces, not just
# localhost inside the container (otherwise it's unreachable from
# the host machine's browser).
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
